# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============ CRITICAL ============
# Generate a secure SECRET_KEY in production!
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here-change-in-production

# ============ DATABASE ============
# Default is SQLite (sqlite:///blog.db)
# For production, consider PostgreSQL: postgresql://user:password@localhost/blog
DATABASE_URL=sqlite:///blog.db

# ============ FLASK ============
FLASK_ENV=development
FLASK_DEBUG=True

# ============ SECURITY ============
# Set to True when using HTTPS in production
SESSION_COOKIE_SECURE=False

# ============ LOGGING ============
LOG_LEVEL=INFO
